# API
# When running under Docker with host networking (recommended on Pi), use localhost
API_BASE_URL=http://127.0.0.1:8000
API_PORT=8000

# Product shell / worker auth
# SECRET_KEY: when set, the worker must send this as a Bearer token to protected API endpoints.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# TECHCAMAI_LICENSE_KEY: leave blank for Community / Developer Preview
# Pro/Enterprise keys format: TCAM-XXXX-XXXX-XXXX
TECHCAMAI_LICENSE_KEY=

# Camera credential encryption
# Leave blank to generate and persist /data/encryption.key on first boot.
TCAI_ENCRYPTION_KEY=
TCAI_KEY_PATH=/data/encryption.key

# DB
DB_PATH=/data/techcamai.db

# Worker
POLL_INTERVAL_SEC=30
CAMERA_SNAPSHOT_URLS=
# example (comma-separated):
# CAMERA_SNAPSHOT_URLS=http://user:pass@192.168.1.10/ISAPI/Streaming/channels/1/picture
PREFER_RTSP=1
CLIP_CAPTURE_ENABLED=1
CLIP_DURATION_SEC=12
CLIPS_DIR=/data/clips

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
