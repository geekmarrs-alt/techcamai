# ============================================================
# TechCam AI Web — Environment Variables
# Copy this file to .env.local and fill in real values.
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/techcamai_web"

# NextAuth v5
AUTH_SECRET="generate-32-char-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_ANNUAL="price_..."       # £699 one-time (annual license)
STRIPE_PRICE_MONTHLY="price_..."      # £64/month recurring
STRIPE_PRICE_BUNDLE="price_..."       # Mini PC bundle (one-time)

# Email (Resend — https://resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@techcamai.com"
RESEND_FROM_NAME="TechCam AI"

# Admin notifications
ADMIN_NOTIFICATION_EMAIL="admin@techcamai.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TechCam AI"

# Optional: seed admin account (used by db:seed only)
SEED_ADMIN_EMAIL="admin@techcamai.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
